{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aportes-comunes",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aportes-comunes-db",
      "database_id": "e92dcc41-c7bc-44fc-9ba9-8ccb23f632e3",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "danieta.com/aportescomunes*",
      "zone_name": "danieta.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
